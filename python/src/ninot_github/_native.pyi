from typing import Optional, TypeVar

from .models import (
    ActionsPublicKeySeed,
    ActionsSecretSeed,
    ActionsSecretsPermission,
    AppliedFault,
    CheckRunSeed,
    CommitStatusSeed,
    FaultRule,
    GitIdentitySeed,
    IssueCommentSeed,
    IssueSeed,
    JobSeed,
    Profile,
    PullRequestSeed,
    ReviewCommentSeed,
    ReviewSeed,
    ReviewThreadSeed,
    TimelineEventSeed,
    UserSeed,
    WorkflowRunSeed,
)

_ServerT = TypeVar("_ServerT", bound=Server)

class Server:
    """A running GitHub-compatible HTTP server."""

    def __init__(self, tls: bool = False) -> None: ...
    @property
    def url(self) -> str: ...
    @property
    def admin_token(self) -> str: ...
    @property
    def ca_cert_path(self) -> Optional[str]: ...
    @property
    def is_recording(self) -> bool: ...
    def add_user(self, login: str, name: Optional[str] = ...) -> None: ...
    def add_org(self, login: str, members: list[str]) -> None: ...
    def add_team(self, org: str, slug: str, members: list[str]) -> None: ...
    def add_token(self, login: str, scopes: list[str]) -> str: ...
    def add_fault(self, rule: FaultRule) -> None: ...
    def clear_faults(self) -> None: ...
    def seed_faults(self, seed: int) -> None: ...
    def applied_faults(self) -> list[AppliedFault]: ...
    def advance_clock(self, milliseconds: int) -> None: ...
    def start_profile(self) -> None: ...
    def stop_profile(self) -> Profile: ...
    def create_repository(
        self,
        owner: str,
        name: str,
        private: bool = ...,
        *,
        description: Optional[str] = ...,
        language: Optional[str] = ...,
        default_branch: str = ...,
    ) -> Repository: ...
    def repository(self, owner: str, name: str) -> Optional[Repository]: ...
    def stop(self) -> None: ...
    def __enter__(self: _ServerT) -> _ServerT: ...  # noqa: PYI019  # Avoid a typing_extensions dependency for Python 3.9.
    def __exit__(
        self,
        exc_type: Optional[type[BaseException]] = ...,
        exc_val: Optional[BaseException] = ...,
        exc_tb: object = ...,
    ) -> None: ...

class Repository:
    """A repository that owns its fixture objects."""

    @property
    def owner(self) -> str: ...
    @property
    def name(self) -> str: ...
    def issue(self, number: int) -> Optional[Issue]: ...
    def pull_request(self, number: int) -> Optional[PullRequest]: ...
    def commit_file(
        self,
        branch: str,
        path: str,
        content: bytes,
        message: str,
        *,
        author: Optional[GitIdentitySeed] = ...,
        committer: Optional[GitIdentitySeed] = ...,
    ) -> Commit: ...
    def commit(self, sha: str) -> Commit: ...
    def fork_from(self, upstream: Repository) -> None: ...
    def create_installation(
        self,
        installation_id: int,
        secrets_permission: Optional[ActionsSecretsPermission] = ...,
    ) -> None: ...
    def set_actions_public_key(self, seed: ActionsPublicKeySeed) -> None: ...
    def create_actions_secret(self, seed: ActionsSecretSeed) -> ActionsSecret: ...
    def actions_secret(self, name: str) -> Optional[ActionsSecret]: ...
    def set_auto_merge_allowed(self, allowed: bool) -> None: ...
    def create_issue(self, number: int, seed: IssueSeed) -> Issue: ...
    def create_pull_request(self, number: int, seed: PullRequestSeed) -> PullRequest: ...
    def create_workflow_run(self, seed: WorkflowRunSeed, jobs: list[JobSeed]) -> WorkflowRun: ...
    def create_project(self, title: str) -> Project: ...

class Issue:
    """An issue that owns its comments."""

    @property
    def number(self) -> int: ...
    def create_comment(self, seed: IssueCommentSeed) -> None: ...

class PullRequest:
    """A pull request that owns its reviews and comments."""

    @property
    def number(self) -> int: ...
    def create_review(self, seed: ReviewSeed) -> Review: ...
    def create_issue_comment(self, seed: IssueCommentSeed) -> None: ...
    def create_review_comment(self, seed: ReviewCommentSeed) -> None: ...
    def create_review_thread(self, seed: ReviewThreadSeed) -> str: ...
    def set_review_decision(self, decision: Optional[str] = ...) -> None: ...
    def create_timeline_event(self, seed: TimelineEventSeed) -> None: ...
    def push_head(
        self,
        sha: str,
        pushed_at: Optional[str] = ...,
        actor: Optional[UserSeed] = ...,
    ) -> None: ...

class Review:
    """A review that owns its pull request fixture."""

    @property
    def id(self) -> int: ...
    @property
    def node_id(self) -> str: ...

class WorkflowRun:
    """An Actions workflow run that owns job log fixtures."""

    @property
    def id(self) -> int: ...
    def set_job_log(self, job_id: int, text: str) -> None: ...

class ActionsSecret:
    """An encrypted secret stored by a repository fixture."""

    @property
    def name(self) -> str: ...
    @property
    def encrypted_value(self) -> str: ...
    @property
    def key_id(self) -> str: ...

class Commit:
    """A Git commit that owns check-run and status fixtures."""

    @property
    def sha(self) -> str: ...
    def create_check_run(self, seed: CheckRunSeed) -> None: ...
    def create_status(self, seed: CommitStatusSeed) -> None: ...

class Project:
    """A Projects v2 board that owns fields and issue items."""

    @property
    def node_id(self) -> str: ...
    def create_field(self, name: str, options: list[str]) -> None: ...
    def create_issue_item(self, issue: Issue, field_values: dict[str, str]) -> str: ...
